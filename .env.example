# TaskFlow AI — Environment Configuration Example
# Copy this file to .env and replace placeholder values with your credentials.

# Application Settings
PROJECT_NAME="TaskFlow AI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="generate_a_secure_random_secret_key_for_production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with asyncpg for async, psycopg for sync/alembic)
# Example: postgresql+asyncpg://postgres:postgres@localhost:5432/taskflow_ai
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/taskflow_ai"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/taskflow_ai"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ChromaDB Persistent Storage
CHROMA_PERSIST_DIRECTORY="./Data/chroma_db"

# LLM Provider API Keys (Fill with your keys)
GROQ_API_KEY="your_groq_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
OPENROUTER_API_KEY="your_openrouter_api_key_here"
